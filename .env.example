# =============================================================================
# Zerodha Kite Connect credentials
# Generate / manage at: https://developers.kite.trade/
# IMPORTANT: The access token expires every day. Run `trading auth` each morning.
# =============================================================================
KITE_API_KEY=your_api_key_here
KITE_API_SECRET=your_api_secret_here

# =============================================================================
# TimescaleDB (PostgreSQL)
# Matches the docker-compose.yml defaults below.
# =============================================================================
DATABASE_URL=postgresql://trading:trading_pass@localhost:5432/trading_db

# =============================================================================
# Redis
# Used to cache the daily Kite access token and (later) live state.
# =============================================================================
REDIS_URL=redis://localhost:6379/0

# =============================================================================
# Local raw data archive (Parquet files of raw Kite API responses)
# A relative or absolute path. Created automatically on first ingest.
# =============================================================================
DATA_DIR=./data

# =============================================================================
# Logging
# =============================================================================
LOG_LEVEL=INFO

# =============================================================================
# Reader agent (scheduled incremental ingestion)
# Cron is evaluated in the container's timezone; further gated to NSE session hours.
# =============================================================================
# READER_INTERVALS=["5minute","minute"]
# READER_LOOKBACK_MINUTES=90
# READER_SCHEDULE_CRON=5 * * * *

# =============================================================================
# Bus (Redis Streams) — stream keys shared by Reader (producer) and Backtester (consumer)
# =============================================================================
# BUS_BAR_STREAM=market.bars
# BUS_ALERT_STREAM=alerts

# =============================================================================
# Phase 5 external services (paper-trading pipeline)
# All optional until the corresponding agent is enabled; keys NEVER go in git.
# =============================================================================
# StockInsights.ai — NSE/BSE filings + tagged news (news agent)
# STOCKINSIGHTS_API_KEY=your_key_here
# STOCKINSIGHTS_DAILY_BUDGET=50

# Anthropic — real admission reviewer (Claude Haiku). Spend controls keep a small
# credit plan alive: hard monthly USD cap + one-time alert threshold (Redis-tracked).
# ANTHROPIC_API_KEY=your_key_here
# LLM_PROVIDER=anthropic          # "mock" (default) or "anthropic"
# LLM_DAILY_CALL_BUDGET=100
# LLM_MONTHLY_USD_CAP=2.0
# LLM_SPEND_ALERT_USD=1.5

# Namespace / replay / reporter (Phase 5d')
# NAMESPACE=live                  # "live" or "replay" — report paths + log context
# REPLAY_MODE=false               # analyst skips Kite backfill when true
# STRATEGIST_FLUSH_IDLE_SECONDS=90
# REPORTER_POLL_SECONDS=60
# REPORTS_DIR=./reports

# Telegram notifier (alerts, fills, daily digest)
# TELEGRAM_BOT_TOKEN=your_token_here
# TELEGRAM_CHAT_ID=your_chat_id_here

# Token-expiry email reminders (SMTP) — emails you every 20 min (07:00–15:30 IST, trading
# days) while the daily Kite token is missing, and stops once `trading auth` is run.
# Gmail: SMTP_PASSWORD must be an App Password (myaccount.google.com/apppasswords), not
# your account password. Unset = notifier no-ops.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=your_16_char_app_password
# ALERT_EMAIL_TO=you@gmail.com
# TOKEN_ALERT_START_IST=07:00
# TOKEN_ALERT_END_IST=15:30
